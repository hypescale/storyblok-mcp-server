{
  "name": "storyblok-mcp-server",
  "version": "1.0.0",
  "description": "Storyblok MCP Server - TypeScript Implementation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "storyblok-mcp-server": "./dist/index.js"
  },
  "scripts": {
